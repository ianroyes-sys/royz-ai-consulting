# Turso / libSQL database (production). Leave empty locally to use SQLite under data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Long random string used to sign the owner session cookie
AUTH_SECRET=
# Password for the owner studio at /login
ADMIN_PASSWORD=
# Public base URL of the app
APP_URL=http://localhost:3091
# Stripe secret key, webhook signing secret and billing portal configuration ID
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=
# Optional: scripts/setup-stripe.mjs refuses to run against any other Stripe account ID
STRIPE_EXPECTED_ACCOUNT=
